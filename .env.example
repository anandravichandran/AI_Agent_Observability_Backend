# ---------------------------------------------------------------------------
# ArmForge AI Backend — environment template
# Copy to `.env` and adjust. Every variable is validated at boot (src/config/env.ts).
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
APP_NAME=dern-ai
PORT=8080
HOST=0.0.0.0
API_PREFIX=/api
API_VERSION=v1
# Express trust proxy setting: false | true | loopback | a hop count | a CIDR list
TRUST_PROXY=loopback
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000
# Public URL of the web client, used to build links in outbound email
APP_WEB_URL=http://localhost:3000

# --- PostgreSQL (Prisma) -----------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_Prpdtny0B3Hk@ep-quiet-dew-azir0y40-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

DATABASE_MAX_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_RETRY_ATTEMPTS=5
DATABASE_RETRY_DELAY_MS=2000
DATABASE_LOG_QUERIES=false

# --- Logging ----------------------------------------------------------------
# error | warn | info | http | debug
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_TO_FILE=false
LOG_DIR=logs
LOG_MAX_FILES=14d

# --- CORS -------------------------------------------------------------------
# Comma separated origin list, or * for any origin.
# NOTE: cookie-based auth requires explicit origins + CORS_CREDENTIALS=true.
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Tighter budget applied to credential and OTP endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# --- API documentation ------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

# --- JWT --------------------------------------------------------------------
# REQUIRED in production, minimum 32 characters, and the two must differ.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJDaGF0X0FwcGxpY2F0aW9uIiwibmFtZSI6IkFuYW5kIFJhdmljaGFuZHJhbiIsImFkbWluIjp0cnVlLCJpYXQiOjE3ODQ5ODY3MDh9.XnGzyJlzv-sD6lf8DcYrXEfcolkjPBQd_oW1atBqVcg
JWT_REFRESH_SECRET=2c3785cbbe0b1c586dbfd811d2001db7c3d0e78b0eecdab0d61ad69202ae6b52de593636f284e5e72d24090b69535950
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=dern-ai
JWT_AUDIENCE=dern-ai

# --- Password & lockout -----------------------------------------------------
BCRYPT_SALT_ROUNDS=12
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCK_DURATION_MS=900000
# Oldest sessions beyond this count are revoked on new login
AUTH_MAX_ACTIVE_SESSIONS=5

# --- OTP --------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5
OTP_RESEND_COOLDOWN_MS=60000

# --- Cookies ----------------------------------------------------------------
COOKIE_ACCESS_NAME=dern-ai
COOKIE_REFRESH_NAME=dern-ai
# Leave blank for a host-only cookie
COOKIE_DOMAIN=
# Forced to true in production regardless of this value
COOKIE_SECURE=false
# lax | strict | none  (none requires secure=true)
COOKIE_SAME_SITE=lax

# --- Mail -------------------------------------------------------------------
# smtp | stream  (stream writes the message to the log instead of sending it)
# ==============================
# SMTP (Gmail App Password)
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=anandravichandran127@gmail.com
SMTP_PASS=jxwyxvvvvovzwtgv
EMAIL_FROM=anandravichandran127@gmail.com

# --- Uploads ----------------------------------------------------------------
# Directory (relative to process cwd) where avatars are stored
UPLOAD_DIR=uploads
# Avatar size ceiling in bytes (default 2MB)
UPLOAD_AVATAR_MAX_BYTES=2097152

# --- Model uploads ----------------------------------------------------------
# Directory model files are stored in (relative to process cwd)
MODEL_UPLOAD_DIR=model-uploads
# Temp directory for in-progress uploads
MODEL_UPLOAD_TEMP_DIR=/tmp/armforge-uploads
# Maximum model file size in bytes (default 5 GB)
MODEL_UPLOAD_MAX_BYTES=5368709120

# --- CSRF (double-submit cookie) ---------------------------------------------
CSRF_ENABLED=true
CSRF_COOKIE_NAME=armforge_csrf
CSRF_HEADER_NAME=x-csrf-token

# --- API keys -----------------------------------------------------------------
# Length of the public lookup prefix stored alongside the key hash
API_KEY_PREFIX_LENGTH=10
# Number of random bytes in the generated secret
API_KEY_SECRET_BYTES=32

# --- Device fingerprinting ------------------------------------------------------
DEVICE_FINGERPRINT_ENABLED=true
# log (audit only) | strict (reject refresh on mismatch)
DEVICE_FINGERPRINT_ENFORCEMENT=log

# --- Geo tracking -----------------------------------------------------------------
GEO_TRACKING_ENABLED=true
