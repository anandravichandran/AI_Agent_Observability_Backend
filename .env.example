# ---------------------------------------------------------------------------
# ArmForge AI Backend — environment template
# Copy to `.env` and adjust. Every variable is validated at boot (src/config/env.ts).
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
APP_NAME=armforge-ai-backend
PORT=8080
HOST=0.0.0.0
API_PREFIX=/api
API_VERSION=v1
# Express trust proxy setting: false | true | loopback | a hop count | a CIDR list
TRUST_PROXY=loopback
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000
# Public URL of the web client, used to build links in outbound email
APP_WEB_URL=http://localhost:3000

# --- MongoDB ----------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=armforge
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_AUTO_INDEX=true
MONGO_RETRY_ATTEMPTS=5
MONGO_RETRY_DELAY_MS=2000

# --- Logging ----------------------------------------------------------------
# error | warn | info | http | debug
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_TO_FILE=false
LOG_DIR=logs
LOG_MAX_FILES=14d

# --- CORS -------------------------------------------------------------------
# Comma separated origin list, or * for any origin.
# NOTE: cookie-based auth requires explicit origins + CORS_CREDENTIALS=true.
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Tighter budget applied to credential and OTP endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# --- API documentation ------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

# --- JWT --------------------------------------------------------------------
# REQUIRED in production, minimum 32 characters, and the two must differ.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=armforge-ai
JWT_AUDIENCE=armforge-ai-clients

# --- Password & lockout -----------------------------------------------------
BCRYPT_SALT_ROUNDS=12
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCK_DURATION_MS=900000
# Oldest sessions beyond this count are revoked on new login
AUTH_MAX_ACTIVE_SESSIONS=5

# --- OTP --------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MS=600000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_MS=60000

# --- Cookies ----------------------------------------------------------------
COOKIE_ACCESS_NAME=armforge_access
COOKIE_REFRESH_NAME=armforge_refresh
# Leave blank for a host-only cookie
COOKIE_DOMAIN=
# Forced to true in production regardless of this value
COOKIE_SECURE=false
# lax | strict | none  (none requires secure=true)
COOKIE_SAME_SITE=lax

# --- Mail -------------------------------------------------------------------
# smtp | stream  (stream writes the message to the log instead of sending it)
MAIL_TRANSPORT=stream
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ArmForge AI <no-reply@armforge.ai>"
MAIL_REPLY_TO=support@armforge.ai

# --- Uploads ----------------------------------------------------------------
# Directory (relative to process cwd) where avatars are stored
UPLOAD_DIR=uploads
# Avatar size ceiling in bytes (default 2MB)
UPLOAD_AVATAR_MAX_BYTES=2097152
